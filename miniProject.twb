    <dashboard enable-sort-zone-taborder='true' name='insights 1'>
      <style>
        <style-rule element='dash-text'>
          <format attr='text-align' id='dash-text_5' value='center' />
          <format attr='vertical-align' id='dash-text_5' value='center' />
          <format attr='text-orientation' id='dash-text_5' value='0' />
          <format attr='wrap' id='dash-text_5' value='on' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98120' id='5' type-v2='text' w='99034' x='483' y='940'>
            <formatted-text>
              <run bold='true' fontcolor='#4e79a7' fontname='Times New Roman' fontsize='16'>(Economy &amp; Wealth) اقتصاد العالم والثروة </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'> ثروة العالم والناتج المحلي الأكبر متمركزين في عدد محدود جداً من الدول الكبرى زي الصين وأمريكا واليابان، وباقي دول العالم حصتها أقل بكتير: </run>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>تركز الفلوس في أماكن قليلة</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'>دول صناعية زي ألمانيا واليابان والسعودية بيصدروا منتجات أكتر بكتير ما بيستوردوا، وده بيخلي ميزانهم التجاري كسبان وفي حالة أمان.: </run>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>شطارة التصدير (الفائض التجاري)</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'>أغلب الدول القوية اقتصادياً محافصة على تضخم قليل وتحت السيطرة مع نمو موجب، بينما الدول اللي فيها تضخم عالي بتعاني ومابتنموش كويس: </run>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>التضخم ونمو الاقتصاد</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'>Æ </run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'> الديون الخارجية على الدول بتسجل أرقام ضخمة جداً مقارنة بقدرتها، وده بيبين حجم الفجوة المالية بين الدول النامية والمتقدمة:</run>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>حجم الديون الكبيرة</run>
              <run>Æ&#10;&#10;</run>
              <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'> كبر حجم اقتصاد الدولة مش معناه بالضرورة إن كل مواطن فيها غني، لأن متوسط نصيب الفرد بيتفاوت جامد من دولة للثانية:</run>
              <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>الفرق بين الدولة والفرد</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#4e79a7' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='4' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#ddebf0' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='11163' id='6' type-v2='dashboard-object' w='19010' x='40133' y='80141'>
          <button action='tabdoc:goto-sheet window-id=&quot;{39B62B44-05D1-468A-A0FE-5F155ECBF694}&quot;' button-type='text'>
            <button-visual-state>
              <caption>return to the dashboard</caption>
              <button-caption-font-style bold='true' fontcolor='#4e79a7' fontname='Sitka Text' fontsize='12' underline='true' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='border-color' value='#4e79a7' />
            </button-visual-state>
          </button>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'>
              <zone h='98120' id='9' param='vert' type-v2='layout-flow' w='99034' x='483' y='940'>
                <zone forceUpdate='true' h='98120' id='5' type-v2='text' w='99034' x='483' y='940'>
                  <formatted-text>
                    <run bold='true' fontcolor='#4e79a7' fontname='Times New Roman' fontsize='16'>(Economy &amp; Wealth) اقتصاد العالم والثروة </run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'> ثروة العالم والناتج المحلي الأكبر متمركزين في عدد محدود جداً من الدول الكبرى زي الصين وأمريكا واليابان، وباقي دول العالم حصتها أقل بكتير: </run>
                    <run bold='true' fontcolor='#000000' fontname='Times New Roman' fontsize='16'>تركز الفلوس في أماكن قليلة</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Times New Roman' fontsize='16'>دول صناعية زي ألمانيا واليابان والسعودية بيصدروا منتجات أكتر بكتير ما بيستوردوا، وده بيخلي ميزانهم التجاري كسبان وفي حالة أمان.: </run>
