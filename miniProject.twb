      <column datatype='integer' name='[Area(sq km)]' role='measure' type='quantitative' />
      <column datatype='real' name='[Birth rate(births/1000 population)]' role='measure' type='quantitative' />
      <column caption='Trade Balance' datatype='integer' name='[Calculation_1624306406408195]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Exports]) - ZN([Imports])' />
      </column>
      <column caption='Energy Balance' datatype='integer' name='[Calculation_1624306406506500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Oil - production(bbl/day)]) - ZN([Oil - consumption(bbl/day)])' />
      </column>
      <column caption='Dynamic Metric' datatype='real' name='[Calculation_1624306406707205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1624306405642240]&#13;&#10;  WHEN &apos;GDP&apos; THEN [GDP]&#13;&#10;  WHEN &apos;GDP Per Capita&apos; THEN [GDP - per capita]&#13;&#10;  WHEN &apos;Life Expectancy&apos; THEN [Life expectancy at birth(years)]&#13;&#10;  WHEN &apos;Internet Users&apos; THEN [Internet users]&#13;&#10;END' />
      </column>
      <column caption='Health Efficiency Index' datatype='real' name='[Calculation_1624306406854662]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ZN([GDP - per capita]) &gt; 0 THEN&#13;&#10;  [Life expectancy at birth(years)] / LOG([GDP - per capita])&#13;&#10;END' />
      </column>
      <column caption='Quadrants Category' datatype='string' name='[Calculation_1624306407391239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [GDP - per capita] &gt;= 10000 AND [Life expectancy at birth(years)] &gt;= 70 THEN &apos;High Income - High Health&apos;&#13;&#10;ELSEIF [GDP - per capita] &lt; 10000 AND [Life expectancy at birth(years)] &gt;= 70 THEN &apos;Low Income - High Health (Efficient)&apos;&#13;&#10;ELSEIF [GDP - per capita] &gt;= 10000 AND [Life expectancy at birth(years)] &lt; 70 THEN &apos;High Income - Low Health&apos;&#13;&#10;ELSE &apos;Low Income - Low Health&apos;&#13;&#10;END' />
      </column>
