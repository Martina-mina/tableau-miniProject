    <dashboard enable-sort-zone-taborder='true' name='insights 3'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='98120' id='3' type-v2='text' w='99034' x='483' y='940'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>( Infrastructure &amp; Digital Readiness) التكنولوجيا والبنية التحتية </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>خطوط الهواتف المحمولة بقت بالملايين ومتفوقة جداً على الخطوط الأرضية القديمة؛ لأن العالم كله بقى يعتمد على الشبكات اللاسلكية الأسرع : </run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>الموبايل كسب الأرضي</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> كل ما دخل الفرد والمستوى المادي للبلد بيزيد، كل ما عدد مستخدمين الإنترنت وانتشاره بيزيد بشكل صاروخي : </run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>الإنترنت مربوط بالفلوس</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>الدول اللي عندها مراكز تكنولوجيا وإنترنت كتير (زي أمريكا والصين) بتستهلك وتنتج طاقة وكهرباء بكميات هائلة، لأن التطور الرقمي مربوط مباشرة بشبكة الطاقة : </run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>التكنولوجيا محتاجة كهرباء </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'> الأرقام الكلية للإنترنت في العالم بتقرب من المليار مستخدم، وده بيفهّمنا إن الاقتصاد الرقمي بقى هو أساس الشغل في العصر الحالي : </run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>حجم الاستخدام الضخم </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>الدول النامية قدرت تتخطى مرحلة شبكات الأسلاك الأرضية المكلفة وقفزت مباشرة على شبكات المحمول والاتصالات الحديثة:  </run>
              <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Times New Roman' fontsize='15'>سرعة التطور</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#f28e2b' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='4' />
              <format attr='margin' value='4' />
              <format attr='background-color' value='#f5ead7' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone h='11163' id='5' type-v2='dashboard-object' w='19493' x='40676' y='74618'>
          <button action='tabdoc:goto-sheet window-id=&quot;{C2BEC503-5BF1-4891-8C40-3BA987A12774}&quot;' button-type='text'>
            <button-visual-state>
              <caption>return to the dashboard</caption>
              <button-caption-font-style bold='true' fontcolor='#f28e2b' fontname='Sitka Text' fontsize='12' underline='true' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <format attr='border-color' value='#f28e2b' />
            </button-visual-state>
          </button>
        </zone>
      </zones>
      <devicelayouts>
        <devicelayout auto-generated='true' name='Phone'>
          <size maxheight='700' minheight='700' sizing-mode='vscroll' />
          <zones>
            <zone h='100000' id='9' type-v2='layout-basic' w='100000' x='0' y='0'>
